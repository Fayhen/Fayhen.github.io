---
import ProjectCTAs from "./ProjectCTAs.astro";
import StackPill from "./StackPill.astro";

import type { Project } from "../data/projects";

interface Props {
  project: Project
}

const { project } = Astro.props;
---

<li class="secondary-card animated project-card" data-category={project.category}>
  <span class="category-tag">{project.category}</span>
  <div class="description">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
  </div>
  <div class="footer">
    <ul class="base-list stacks-row">
      {project.stacks.slice(0, 4).map(s => <StackPill stack={s} bgColor="var(--bg-primary)" />)}
      {project.stacks.length > 4 && (
        <li class="overflow-chip">+{project.stacks.length - 4}</li>
      )}
    </ul>
    <ProjectCTAs project={project} />
  </div>
</li>

<style>
  .project-card[data-category="backend"] {
    /* TODO: refactor into project category theme tokens */
    --accent: oklch(60% 0.12 80deg);
    --accent-bg: oklch(95% 0.04 80deg);
  }

  .project-card[data-category="frontend"] {
    /* TODO: refactor into project category theme tokens */
    --accent: oklch(60% 0.12 250deg);
    --accent-bg: oklch(95% 0.04 250deg);
   }

  .project-card[data-category="fullstack"] {
    /* TODO: refactor into project category theme tokens */
    --accent: oklch(60% 0.12 160deg);
    --accent-bg: oklch(95% 0.04 160deg);
   }

  .project-card {
    position: relative;
    padding: 1rem;
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .project-card .category-tag {
    align-self: flex-start;
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  .project-card .description {
    overflow: hidden;
  }

  .project-card .description p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .project-card .footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0 0.5rem;
  }

  .project-card .footer ul {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stacks-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .overflow-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 600;
  }
</style>
