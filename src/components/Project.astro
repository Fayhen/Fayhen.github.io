---
import type { Project } from "../data/projects";

interface Props {
  project: Project
}

const { project } = Astro.props;
---

<li class="card">
  <h3>{project.title}</h3>
  <p>{project.description}</p>
</li>

<style>
  .card {
    padding: 1rem;
    border-radius: 15px;
    background-color: oklch(95.514% 0.00011 271.152);
  }
</style>
