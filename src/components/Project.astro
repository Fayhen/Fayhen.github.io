---
import ProjectCTAs from "./ProjectCTAs.astro";
import StackPill from "./StackPill.astro";

import type { Project } from "../data/projects";

interface Props {
  project: Project
}

const { project } = Astro.props;
---

<li class="card" data-category={project.category}>
  <span class="category-tag">{project.category}</span>
  <div class="description">
    <h3>{project.title}</h3>
    <p>{project.description}</p>
  </div>
  <div class="footer">
    <ul class="base-list stacks-row">
      {project.stacks.slice(0, 4).map(s => <StackPill stack={s} bgColor="oklch(100% 0.00011 271.152)" />)}
      {project.stacks.length > 4 && (
        <li class="overflow-chip">+{project.stacks.length - 4}</li>
      )}
    </ul>
    <ProjectCTAs project={project} />
  </div>
</li>

<style>
  .card[data-category="backend"] {
    --accent: oklch(60% 0.12 80);
    --accent-bg: oklch(95% 0.04 80);
  }

  .card[data-category="frontend"] {
    --accent: oklch(60% 0.12 250);
    --accent-bg: oklch(95% 0.04 250);
   }

  .card[data-category="fullstack"] {
    --accent: oklch(60% 0.12 160);
    --accent-bg: oklch(95% 0.04 160);
   }

  .card {
    position: relative;
    padding: 1rem;
    border-radius: 0.75rem;
    background-color: oklch(95.514% 0.00011 271.152);
    transition: transform 0.2s ease, box-shadow 0.2s ease;

    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(0% 0 0 / 0.1);
  }

  .card .category-tag {
    align-self: flex-start;
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  .card .description {
    overflow: hidden;
  }

  .card .description p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  .card .footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0 0.5rem;
  }

  .card .footer ul {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stacks-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .overflow-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 600;
  }
</style>
