---
import { Image } from "astro:assets";

import ProjectCTAs from "./ProjectCTAs.astro";
import StackPill from "./StackPill.astro";

import type { Project } from "../data/projects";

interface Props {
  project: Project
}

const { project } = Astro.props;

---

<li class="featured-card" data-category={project.category}>
  <div class="layout">
    <div class="hero">
      {project.picture && <Image src={project.picture} alt={project.title} />}
    </div>
    <div class="content">
      <span class="category-tag">{project.category}</span>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
      <div class="footer">
        <ul class="base-list stacks-row">
          {project.stacks.map((stack) => <StackPill stack={stack} bgColor="oklch(100% 0.00011 271.152)" />)}
        </ul>
        <ProjectCTAs project={project} />
      </div>
    </div>
  </div>
</li>

<style>
  .featured-card[data-category="backend"] {
    --accent: oklch(60% 0.12 80deg);
    --accent-bg: oklch(95% 0.04 80deg);
  }

  .featured-card[data-category="frontend"] {
    --accent: oklch(60% 0.12 250deg);
    --accent-bg: oklch(95% 0.04 250deg);
   }

  .featured-card[data-category="fullstack"] {
    --accent: oklch(60% 0.12 160deg);
    --accent-bg: oklch(95% 0.04 160deg);
   }

  .featured-card {
    padding: 1rem;
    border-radius: 15px;
    overflow: hidden;
    position: relative;
    container-type: inline-size;
    background-color: oklch(95.514% 0.0001 271.152deg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .featured-card:hover,
  .featured-card:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(0% 0 0deg / 10%);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card,
    .featured-card:hover,
    .featured-card:focus-within {
      transition: none;
      transform: none;
    }
  }

  .featured-card .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    height: 100%;
  }

  @container (min-width: 28rem) {
    .featured-card .layout {
      grid-template-columns: 1fr 1.4fr;
    }

    .featured-card .hero {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .hero {
    background: linear-gradient(135deg,
      oklch(84.972% 0.0207 250.513deg),
      oklch(97.68% 0.0068 277.074deg));
  }

  .featured-card .hero {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .hero img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category-tag {
    align-self: flex-start;
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  .footer {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 0 0.5rem;
    margin-top: auto;
  }

  .stacks-row {
    display: flex;
    flex-flow: row wrap;
    gap: 0.5rem;
  }


</style>