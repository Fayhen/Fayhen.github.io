---
import { isLocale } from "../i18n/locales";
import { useTranslation } from "../i18n";

import type { Stack } from "../data/stacks";

interface Props {
  size?: "sm" | "md" | "lg"
  stack: Stack
}

const ICON_SIZES = {
  sm: "var(--icon-size-sm)",
  md: "var(--icon-size-md)",
  lg: "var(--icon-size-lg)",
} as const;

const { stack, size = "lg" } = Astro.props;
const iconSize = ICON_SIZES[size];

const Original = stack.icon;
const Themeable = stack.iconThemeable;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);
---

<li
  id={`stack-${stack.slug}`}
  class="stack-icon"
  style={`--icon-size: ${iconSize};`}
>
  <a href={stack.link}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t("skills.stackDocsAriaLabel", { name: stack.name })}
  >
    <Original class="stack-icon-svg-original" aria-hidden="true" />
    <Themeable class="stack-icon-svg-themeable" aria-hidden="true" />
  </a>
</li>

<style>
  .stack-icon {
    border-radius: var(--radius-circle);
    transition: transform var(--motion-base) var(--motion-ease);
  }

  .stack-icon:hover {
    transform: translate(0, -5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-icon,
    .stack-icon:hover {
      transform: none;
    }
  }

  .stack-icon svg {
    height: var(--icon-size);
    width: var(--icon-size);
  }

  .stack-icon-svg-original {
    display: var(--icon-original-display, inline);
  }

  .stack-icon-svg-themeable {
    display: var(--icon-themeable-display, none);
    color: var(--icon-brand);
  }
</style>
