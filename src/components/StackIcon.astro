---
import Image from "astro/components/Image.astro";

import type { Stack } from "../data/stacks";

interface Props {
  height?: string
  width?: string
  stack: Stack
}

const { stack } = Astro.props;
const height = Astro.props.height ?? "3rem";
const width = Astro.props.width ?? "3rem";
---

<li id={`stack-${stack.slug}`} class="stack-icon" style=`--icon-height: ${height}; --icon-width: ${width};`>
  <a href={stack.link} target="_blank" rel="noopener noreferrer">
    <Image src={stack.icon} alt={stack.name} />
  </a>
</li>

<style>
  .stack-icon {
    border-radius: 50%;
    transition: transform ease 300ms;
  }

  .stack-icon:hover {
    transform: translate(0, -5px);
  }

  .stack-icon img {
    height: var(--icon-height);
    width: var(--icon-width);
    object-fit: contain;
  }
</style>
