---
import Luv from "../assets/icons/far/heart-regular-full.svg";
import Made from "../assets/icons/fas/terminal-solid-full.svg";

import { isLocale } from "../i18n/locales";
import { useTranslation } from "../i18n";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);
---

<footer id="footer">
  <div class="page-container">
    <p>
      <Made id="made" class="footer-icon" role="img" aria-label={t("footer.made")} />
      {t("footer.with")}
      <Luv id="luv" class="footer-icon" role="img" aria-label={t("footer.love")} />
      {t("footer.by")}
      <b id="me">Diego Garcia Cordeiro Souza</b>
      | {t("footer.builtWith")}
      <b id="this">Astro</b>
    </p>
  </div>
</footer>

<style>
    #footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space-2xs);
    background-color: var(--surface-footer);
    color: var(--text-on-footer);
    letter-spacing: 0.01rem;
    word-spacing: 0.1rem;
    text-align: center;
  }

  #footer p {
    margin: 0;
  }

  #footer #luv {
    color: var(--footer-highlight-luv);
  }

  #footer #made {
    color: var(--footer-highlight-made);
  }

  #footer #me {
    color: var(--footer-highlight-me);
  }

  #footer #this {
    color: var(--footer-highlight-this);
  }

  .footer-icon {
    margin-bottom: -0.1rem;
    height: 1rem;
    width: 1rem;
  }
</style>