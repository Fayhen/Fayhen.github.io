---
import { getRelativeLocaleUrl } from "astro:i18n";

import { isLocale, stripLocaleFromPath } from "../i18n/locales";
import { useTranslation } from "../i18n";

const route = stripLocaleFromPath(Astro.url.pathname);

const current = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(current);

const options = [
  { code: "en", lang: "en", label: "EN", name: t("nav.langOptionEn") },
  { code: "pt-br", lang: "pt-BR", label: "PT", name: t("nav.langOptionPt") },
];

const target = options.find((opt) => opt.code !== current) ?? options[0];
const href = getRelativeLocaleUrl(target.code, route);
---

<a class="lang-switcher" href={href}
  hreflang={target.lang}
  aria-label={t("nav.langOptionAria", { locale: target.name })}
>
  {options.map((l) => (
    <span class="lang-option" lang={l.lang} data-active={l.code === current}>
      {l.label}
    </span>
  ))}
</a>

<style>
  .lang-switcher {
    display: inline-flex;
    gap: 0.125rem;
    padding: 0.125rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    text-decoration: none;
  }

  .lang-option {
    display: block;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    color: var(--link);
    line-height: 1;
  }

  .lang-switcher:hover .lang-option:not([data-active="true"]) {
    color: var(--link-hover);
  }

  .lang-switcher:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .lang-option[data-active="true"] {
    background: var(--nav-fg);
    color: var(--color-tertiary);
  }
</style>
