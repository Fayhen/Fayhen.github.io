---
import "../../styles/global.css";

import Base from "../../layouts/Base.astro";
import Header from "../Header.astro";

import { getRelativeLocaleUrl } from "astro:i18n";
import { isLocale } from "../../i18n/locales";
import { useTranslation } from "../../i18n";

import {
  ALL_COLORS,
  COLOR_PAIRINGS,
  FONT_TOKENS,
  THEMES,
  TYPOGRAPHY
} from "../../scripts/designSystem";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);

const navItems = [
  { label: t("nav.backHome"), href: getRelativeLocaleUrl(locale, "") }
];

const textSampleFirst = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
const textSampleSecond = "Vivamus dignissim ante aliquam, tempor orci eget, tristique sem.";
---

<Base title={t("designSystemPage.title")}>
  <Header {navItems} />

  <main id="main-content" tabindex="-1">
    <p id="copy-status" role="status" class="sr-only"></p>

    <div class="page-container">
      <h1>{t("designSystemPage.title")}</h1>
    </div>

    <section id="typography-section" class="page-container">
      <h2>{t("designSystemPage.sectionTypography")}</h2>
      {
        TYPOGRAPHY.map(({ fontName, variable }) => (
          <div style={`font-family: var(${variable});`}>
            <h3>{fontName}: {variable}</h3>
            <div>
              {
                FONT_TOKENS.map(({ property, propertyName, tokens }) => (
                  <h4>{propertyName}</h4>
                  <dl class="token-box-row">
                    {
                      tokens.map((token) => (
                        <div class="token-box">
                          <dt class="token-box-header">
                            <code>{token}</code>
                          </dt>
                          <dd class="token-box-body" style={`${property}: var(${token})`}>
                            <p aria-hidden="true">{textSampleFirst}</p>
                            <p aria-hidden="true">{textSampleSecond}</p>
                          </dd>
                        </div>
                      ))
                    }
                  </dl>
                ))
              }
            </div>
          </div>
        ))
      }
    </section>

    <section id="color-pairings-section" class="page-container">
      <h2>{t("designSystemPage.sectionColorPairings")}</h2>
      {
        COLOR_PAIRINGS.map(({ surface, on }) => (
          <section>
            <div class="palette-surface-title">
              <h3><code>{surface}</code></h3>
            </div>

            <div>
              <div class="color-pairings-row">
                {
                  THEMES.map(([theme, themeName]) => (
                    <div class="color-pairing-box">
                      <div class="color-pairing-header">
                        <div class="color-pairing-header-controls">
                          <button
                            class="icon-circle outer-contrast"
                            data-copy="token-name"
                            data-token={surface}
                            type="button"
                          >
                            <span class="sr-only">
                              {t("designSystemPage.copyActionSurfaceTokenName", { surface })}
                            </span>
                          </button>
                          <button
                            class="icon-circle outer-contrast"
                            data-copy="token-value"
                            data-token={surface}
                            type="button"
                          >
                            <span class="sr-only">
                              {t("designSystemPage.copyActionSurfaceTokenValue", { surface, themeName })}
                            </span>
                          </button>
                        </div>
                        <span>{themeName}</span>
                      </div>

                      <div
                        class="color-pairing-theme"
                        data-theme={theme}
                        style={`background-image: linear-gradient(var(${surface}), var(${surface}))`}
                      >
                        {
                          on.map(({ token, kind = "body" }) => (
                            <div
                              class="pairing-sample"
                              style={`color: var(${token})`}
                              data-kind={kind}
                              data-surface={surface}
                              data-token={token}
                            >
                              <div class="pairing-sample-info">
                                <code>{token}</code>

                                <div hidden class="pairing-sample-details audit-success">
                                  <div class="pairing-sample-controls">
                                    <button
                                      class="icon-circle theme-contrast"
                                      style={`color: var(${token})`}
                                      data-copy="token-name"
                                      data-token={token}
                                      type="button"
                                    >
                                      <span class="sr-only">
                                        {t("designSystemPage.copyActionTokenName", { token })}
                                      </span>
                                    </button>
                                    <button
                                      class="icon-circle theme-contrast"
                                      style={`color: var(${token})`}
                                      data-copy="token-value"
                                      data-token={token}
                                      type="button"
                                    >
                                      <span class="sr-only">
                                        {t("designSystemPage.copyActionTokenValue", { token, themeName })}
                                      </span>
                                    </button>
                                  </div>
                                  <p class="pairing-contrast-info"></p>
                                </div>

                                <div hidden class="pairing-sample-details audit-failure">
                                  <div class="pairing-sample-controls">
                                    <button
                                      class="icon-circle error-contrast"
                                      data-copy="token-name"
                                      data-token={token}
                                      type="button"
                                    >
                                      <span class="sr-only">
                                        {t("designSystemPage.copyActionTokenName", { token })}
                                      </span>
                                    </button>
                                    <button
                                      class="icon-circle error-contrast"
                                      data-copy="token-value"
                                      data-token={token}
                                      type="button"
                                    >
                                      <span class="sr-only">
                                        {t("designSystemPage.copyActionTokenValue", { token, themeName })}
                                      </span>
                                    </button>
                                    <div class="icon-circle error-contrast alert"></div>
                                  </div>
                                  <p class="pairing-contrast-info"></p>
                                </div>
                              </div>
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
        ))
      }
    </section>

    <section id="full-palette-section" class="page-container">
      <h2>{t("designSystemPage.sectionRawPalette")}</h2>
      <div class="palettes-wrapper">
        {
          THEMES.map(([theme, themeName]) => (
            <div>
              <h3>{themeName}</h3>
              <ul class="base-list" data-theme={theme}>
                {
                  ALL_COLORS.map((colorToken) => (
                    <li>
                      <code>{colorToken}</code>
                      <div class="palette-color-box" style={`background: var(${colorToken})`}></div>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<script>
  import { copyText } from "../../scripts/clipboard";
  import { maybeLog } from "../../scripts/console";
  import { audit, flatten, ratio, isUIKind, WCAG_SC } from "../../scripts/contrast";

  import { useTranslation } from "../../i18n";
  import { isLocale } from "../../i18n/locales";

  const rawLocale = document.documentElement.lang?.toLocaleLowerCase();
  const locale = isLocale(rawLocale) ? rawLocale : "en";
  const t = useTranslation(locale);

  let copyStatusFlag: HTMLElement | null = null;
  let copyStatusTimer: number | undefined;
  const copyStatusWcagFeedback = document.getElementById("copy-status");

  listeners();
  wcagContrastAudit();

  /**
   * Sets up event listeners for this page.
   */
  function listeners() {
    const main = document.getElementsByTagName("main")[0];

    main?.addEventListener("click", (e) => {
      const copyBtn = (e.target as HTMLElement)
        .closest<HTMLButtonElement>("[data-copy]");

      if (!copyBtn) return;
      void handlePaletteCopy(copyBtn);
    });
  }

  /**
   * Copies either a palette token name or its computed value,
   * depending on the clicked copy button, onto the user's
   * clipboard.
   *
   * The clicked button is expect to carry both the token
   * name in the `data-token` attribute, and the copy mode
   * on the `data-copy` attribute. The copy mode triggers
   * different copy behaviors:
   *
   * - `token-name`: copies the token name to the user's
   *   clipboard.
   * - `token-value`: computes the tokens value against the
   *   button's theme to the user's clipboard.
   *
   * The copy operation result result is announced both
   * visually by flashing the button to a checkmark or x-mark,
   * and to assistive technologies via a `#copy-status`
   * element.
   *
   * @param btn Clicked button. Expected to carry the token
   *   name in `data-token` and the copy mode on `data-copy`.
   */
  async function handlePaletteCopy(btn: HTMLElement) {
    const copyType = btn.dataset.copy;
    const token = btn.dataset.token;
    if (!copyType || !token) {
      maybeLog("warn", {
        msg: "Copy aborted: key data attributes missing.", copyType, token, btn
      });
      flashCopyState(btn, "failed");
      announceCopy(t("designSystemPage.copyFeedbackFail", { token: `${token}`}));
      return;
    }

    const text = copyType === "token-value"
      ? evaluatePaletteTokenValue(btn, token)
      : token;

    if (!text) {
      maybeLog("warn", {
        msg: "Copy aborted: failed to evaluate target value", token, text, btn
      });
      flashCopyState(btn, "failed");
      announceCopy(t("designSystemPage.copyFeedbackFail", {token}));
      return;
    }

    const copied = await copyText(text);

    if (!copied) {
      maybeLog("warn", {
         msg: "Failed copy: clipboard operation failed to resolve.", token, copied, btn
      });
      flashCopyState(btn, "failed");
      announceCopy(t("designSystemPage.copyFeedbackFail", {token}));
      return;
    }

    flashCopyState(btn, "copied");

    announceCopy(
      copyType === "token-value"
        ? t("designSystemPage.copyFeedbackSuccessValue", { token, text })
        : t("designSystemPage.copyFeedbackSuccessToken", { token })
    );
  }

  /**
   * Computes a palette token value against a design system
   * theme. Uses the clicked button to target the correct
   * theme.
   *
   * @param btn Clicked button.
   * @param token Token name.
   */
  function evaluatePaletteTokenValue(btn: HTMLElement, token: string) {
    const themeBox = themeBoxOf(btn);
    if (!themeBox) return;

    return getComputedStyle(themeBox)
      .getPropertyValue(token)
      .trim();
  }

  /**
   * Finds which theme box element a clicked button lies at.
   * Used for the copy buttons on the palette samples.
   *
   * @param btn Clicked button.
   */
  function themeBoxOf(btn: HTMLElement) {
    return btn.closest<HTMLElement>(".color-pairing-theme")
      ?? btn.closest(".color-pairing-box")?.querySelector<HTMLElement>(".color-pairing-theme")
      ?? null;
  }

  /**
   * Announces a copy event just took place for assistive
   * technologies.
   *
   * @param msg Announced message. Ex.: "Copied color token."
   */
  function announceCopy(msg: string) {
    if (!copyStatusWcagFeedback) return;
    copyStatusWcagFeedback.textContent = "";
    requestAnimationFrame(() => copyStatusWcagFeedback.textContent = msg);
  }

  /**
   * Briefly shows either a copy success or failure feedback
   * on the clicked button. The button icon will be swapped
   * by a checkmark or x-mark for two seconds then reset.
   *
   * @param btn Clicked button.
   * @param state Copy state, either `"copied"` or `"failed"`.
   */
  function flashCopyState(btn: HTMLElement, state: "copied" | "failed") {
    clearTimeout(copyStatusTimer);
    copyStatusFlag?.removeAttribute("data-state");

    btn.dataset.state = state;
    copyStatusFlag = btn;

    copyStatusTimer = window.setTimeout(() => {
      btn.removeAttribute("data-state");
      copyStatusFlag = null;
    }, 2000);
  }

  /**
   * Audits contrast ratios on color pairing samples across
   * the design system, in accordance with WCAG specification
   * for different UI types.
   */
  function wcagContrastAudit() {
    const samples = document.querySelectorAll<HTMLElement>(".pairing-sample");

    for (const sample of samples) {
      const cell = sample.closest<HTMLElement>(".color-pairing-theme");
      const surfaceToken = sample.dataset.surface;

      if (!cell || !surfaceToken) {
        maybeLog("warn", {
          msg: "Color sample auditing failed: key elements not found.", sample, cell, surfaceToken
        });
        continue;
      }

      const elementType = sample.dataset.kind;

      if (!isUIKind(elementType)) {
        maybeLog("warn", {
          msg: "Unable to compute contrast. UI type not found on element dataset.", sample, elementType
        });
        showContrastFailure(sample, t("designSystemPage.contrastComputeFailed"));
        continue;
      }

      const cs = getComputedStyle(cell);
      const base = cs.getPropertyValue("--surface-base").trim();
      const surface = cs.getPropertyValue(surfaceToken).trim();
      const text = getComputedStyle(sample).color;

      // composite of the surface over its theme background
      const bg = flatten(base, surface);

      // composite of text over the above
      const fg = flatten(base, surface, text);

      if (!bg || !fg) {
        maybeLog("warn", {
          msg: "Contrast ratio computation failed.", base, surface, text
        });
        showContrastFailure(sample, t("designSystemPage.contrastComputeFailed"));
        continue;
      }

      const cr = ratio(bg, fg);

      if (audit(cr, elementType)) {
        showContrastInfo(sample, cr);
      }
      else {
        const criterion = WCAG_SC[elementType];
        showContrastFailure(sample, t("designSystemPage.contrastAuditFailure", { criterion, cr: cr.toFixed(2) }));
      }
    }
  }

  function showContrastInfo(sample: Element, cr: number) {
    const wrapperEl = sample.querySelector<HTMLElement>(".pairing-sample-details.audit-success");
    const infoEl = sample.querySelector<HTMLElement>(".audit-success > .pairing-contrast-info");
    if (!wrapperEl || !infoEl) return;

    infoEl.textContent = t("designSystemPage.contrastAuditSuccess", { cr: cr.toFixed(2) });
    wrapperEl.hidden = false;
  }

  function showContrastFailure(sample: Element, reason: string) {
    const wrapperEl = sample.querySelector<HTMLElement>(".pairing-sample-details.audit-failure");
    const infoEl = sample.querySelector<HTMLElement>(".audit-failure > .pairing-contrast-info");
    if (!wrapperEl || !infoEl) return;

    infoEl.textContent = reason;
    wrapperEl.hidden = false;
  }
</script>

<style>
  main {
    padding: var(--space-section-2xl) var(--space-section-sm);
  }

  h2 {
    margin-bottom: var(--space-md);
  }

  h3 {
    margin-bottom: var(--space-sm);
  }

  h4 {
    margin-bottom: var(--space-xs);
  }

  p, dl, dd {
    margin: 0;
  }

  button {
    cursor: pointer;
  }

  section {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-section-sm);
  }

  .token-box-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .token-box {
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    overflow: clip;
  }

  .token-box-header {
    border-bottom: 1px solid var(--text-on-base);
    padding: var(--space-xs);
  }

  .token-box-body {
    padding: var(--space-xs);
  }

  .color-pairings-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-md);
  }

  .color-pairing-box {
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    overflow: clip;
  }

  .color-pairing-header {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .color-pairing-header > span {
    display: block;
    padding: var(--space-3xs) 0;
    text-align: center;
  }

  .color-pairing-header-controls {
     position: absolute;
     left: calc(var(--space-xs) + 0.35rem);
     display: flex;
     gap: var(--space-2xs);
  }

  .color-pairing-theme {
    height: 100%;
    padding: var(--space-sm);
    background-color: var(--surface-base);
    border-top: 1px solid var(--text-on-base);
  }

  .pairing-sample {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding:var(--space-2xs) 0;
  }

  .pairing-sample-info {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .pairing-sample-details {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs);
  }

  .pairing-sample-details.audit-failure {
    background-color: #fff;
    color: #000;
    border-radius: var(--radius-lg);
  }

  .pairing-sample-controls {
    display: flex;
    gap: var(--space-2xs);
  }

  .icon-circle {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-circle);
    height: var(--icon-size-md);
    width: var(--icon-size-md);
  }

  .icon-circle::after {
    content: "";
    position: absolute;
    height: var(--icon-size-sm);
    width: var(--icon-size-sm);
    background-color: currentColor;
    mask: var(--icon-mask) center / contain no-repeat;
  }

  /* Escape hatch for forced colors mode. Background colors
     are overridden with a system-defined palette, interfering
     with icon masks in the ::after elements above.

     We opt out and resupply the icon background color with
     a system foreground color, ensuring contrast against the
     system background. This foreground comes from the system
     keywords below.

     Note that `forced-color-adjust: none` must be followed
     by one such system color keyword. This way we ensure user
     choice is preserved, since a color literal would override
     the override. */
  @media (forced-colors: active) {
    .icon-circle::after {
      forced-color-adjust: none;
      background-color: ButtonText;
    }

    .icon-circle.alert::after {
      background-color: CanvasText;
    }
  }

  .icon-circle[data-copy="token-name"] {
    --icon-mask: url("../../assets/icons/fas/copy.svg");
  }

  .icon-circle[data-copy="token-value"] {
    --icon-mask: url("../../assets/icons/fas/palette.svg");
  }

  .icon-circle.alert {
    --icon-mask: url("../../assets/icons/fas/exclamation.svg");
  }

  .icon-circle[data-state="copied"] {
    --icon-mask: url("../../assets/icons/fas/check.svg");
  }

  .icon-circle[data-state="failed"] {
    --icon-mask: url("../../assets/icons/fas/xmark-solid-full.svg");
  }

  .icon-circle.error-contrast {
    background-color: #fff;
    color: #c00;
    border: 1px solid #c00;
  }

  .icon-circle.outer-contrast {
    background-color: var(--surface-base);
    color: var(--text-on-base);
    border: 1px solid var(--text-on-base);
  }

  .icon-circle.theme-contrast {
    background-color: transparent;
    color: inherit;
    border: 1px solid currentColor;
  }

  .pairing-contrast-info {
    font-size: var(--font-size-sm);
  }

  .audit-failure .pairing-contrast-info {
    color: #c00;
  }

  #full-palette-section {
    margin-top: var(--space-section-md);
  }

  #full-palette-section h3 {
    text-align: center;
  }

  #full-palette-section ul {
    margin-top: var(--space-2xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    background-color: var(--surface-base);
    color: var(--text-on-base);
  }

  #full-palette-section li code {
    font-style: italic;
    font-size: var(--font-size-sm);
  }

  .palettes-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-md);
  }

  .palette-color-box {
    height: var(--space-xl);
    width: 100%;
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
  }
</style>
