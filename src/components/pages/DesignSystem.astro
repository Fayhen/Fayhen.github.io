---
import "../../styles/global.css";

import Base from "../../layouts/Base.astro";
import Header from "../Header.astro";

import { ALL_COLORS, COLOR_PAIRINGS, THEMES } from "../../scripts/designSystem";
import { getRelativeLocaleUrl } from "astro:i18n";
import { isLocale } from "../../i18n/locales";
import { useTranslation } from "../../i18n";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);

const navItems = [
  { label: t("nav.backHome"), href: getRelativeLocaleUrl(locale, "") }
];
---

<Base title="Design System">
  <Header {navItems} />

  <main id="main-content" tabindex="-1">
    <div class="page-container">
      <h1>Design system</h1>
    </div>

    <section id="color-pairings-section" class="page-container">
      <h2>Color pairings</h2>
      {
        COLOR_PAIRINGS.map(({ surface, on }) => (
          <section>
            <h3><code>{surface}</code></h3>
            <div class="color-pairings">
              <div class="color-pairings-row">
                {
                  THEMES.map(theme => (
                    <div class="color-pairing-cell">
                      <span>{theme}</span>
                      <div
                        class="color-pairing-theme"
                        data-theme={theme}
                        style={`background-image: linear-gradient(var(${surface}), var(${surface}))`}
                      >
                        {
                          on.map(({ token, kind = "body" }) => (
                            <p
                              class="pairing-sample"
                              style={`color: var(${token})`}
                              data-kind={kind}
                              data-surface={surface}
                              data-text={token}
                            >
                              <code>{token}</code>
                            </p>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
        ))
      }
    </section>

    <section id="full-pallete-section" class="page-container">
      <h2>Raw pallete</h2>
      <div class="palletes-wrapper">
        {
          THEMES.map(theme => (
            <div>
              <h3>{theme}</h3>
              <ul class="base-list pallete-list" data-theme={theme}>
                {
                  ALL_COLORS.map((colorToken) => (
                    <li>
                      <p>{colorToken}</p>
                      <div class="pallete-color-box" style={`background: var(${colorToken})`}></div>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  main {
    padding: var(--space-section-2xl) var(--space-section-sm);
  }

  ul {
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  li p {
    margin: 0;
    font-style: italic;
    font-size: var(--font-size-sm);
  }

  #color-pairings-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-section-sm);
  }

  .color-pairings-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-md);
  }

  .color-pairing-cell {
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .color-pairing-cell span {
    display: block;
    padding: var(--space-3xs) 0;
    text-align: center;
  }

  .color-pairing-theme {
    padding: var(--space-sm);
    background-color: var(--surface-base);
    border-top: 1px solid var(--text-on-base);
  }

  #full-pallete-section {
    margin-top: var(--space-section-md);
  }

  .palletes-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-md);
  }

  .pallete-list {
    background-color: var(--surface-base);
    color: var(--text-on-base);
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
  }

  .pallete-color-box {
    height: var(--space-xl);
    width: 100%;
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
  }
</style>
