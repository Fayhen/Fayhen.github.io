---
import "../../styles/global.css";

import Base from "../../layouts/Base.astro";
import Header from "../Header.astro";

import Copy from "../../assets/icons/fas/copy.svg";
import Exclamation from "../../assets/icons/fas/exclamation.svg";
import Palette from "../../assets/icons/fas/palette.svg";

import { ALL_COLORS, COLOR_PAIRINGS, THEMES } from "../../scripts/designSystem";
import { getRelativeLocaleUrl } from "astro:i18n";
import { isLocale } from "../../i18n/locales";
import { useTranslation } from "../../i18n";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);

const navItems = [
  { label: t("nav.backHome"), href: getRelativeLocaleUrl(locale, "") }
];
---

<Base title="Design System">
  <Header {navItems} />

  <main id="main-content" tabindex="-1">
    <p id="copy-status" role="status" class="sr-only"></p>

    <div class="page-container">
      <h1>Design system</h1>
    </div>

    <section id="color-pairings-section" class="page-container">
      <h2>Color pairings</h2>
      {
        COLOR_PAIRINGS.map(({ surface, on }) => (
          <section>
            <div class="palette-surface-title">
              <h3><code>{surface}</code></h3>
            </div>

            <div>
              <div class="color-pairings-row">
                {
                  THEMES.map(([theme, themeName]) => (
                    <div class="color-pairing-box">
                      <div class="color-pairing-header">
                        <div class="color-pairing-header-controls">
                          <button
                            class="icon-circle outer-contrast"
                            data-copy="pairing-surface-token-name"
                            type="button"
                          >
                            <Copy class="icon" aria-hidden="true" />
                            <span class="sr-only">Copy {surface} token value</span>
                          </button>
                          <button
                            class="icon-circle outer-contrast"
                            data-copy={`pairing-surface-token-${theme}`}
                            type="button"
                          >
                            <Palette class="icon" aria-hidden="true" />
                            <span class="sr-only">Copy {surface} color value</span>
                          </button>
                        </div>
                        <span>{themeName}</span>
                      </div>

                      <div
                        class="color-pairing-theme"
                        data-theme={theme}
                        style={`background-image: linear-gradient(var(${surface}), var(${surface}))`}
                      >
                        {
                          on.map(({ token, kind = "body" }) => (
                            <div
                              class="pairing-sample"
                              style={`color: var(${token})`}
                              data-kind={kind}
                              data-surface={surface}
                              data-token={token}
                            >
                              <div class="pairing-sample-info">
                                <code>{token}</code>

                                <div hidden class="pairing-sample-details audit-success">
                                  <div class="pairing-sample-controls">
                                    <button
                                      class="icon-circle theme-contrast"
                                      style={`color: var(${token})`}
                                      data-copy="pairing-token-name"
                                      data-token={token}
                                      type="button"
                                    >
                                      <Copy class="icon" aria-hidden="true" />
                                      <span class="sr-only">Copy {token} token name</span>
                                    </button>
                                    <button
                                      class="icon-circle theme-contrast"
                                      style={`color: var(${token})`}
                                      data-copy="pairing-token-value"
                                      data-token={token}
                                      type="button"
                                    >
                                      <Palette class="icon" aria-hidden="true" />
                                      <span class="sr-only">Copy {token} color value</span>
                                    </button>
                                  </div>
                                  <p class="pairing-contrast-info"></p>
                                </div>

                                <div hidden class="pairing-sample-details audit-failure">
                                  <div class="pairing-sample-controls">
                                    <button
                                      class="icon-circle error-contrast"
                                      data-copy="pairing-token-name"
                                      data-token={token}
                                      type="button"
                                    >
                                      <Copy class="icon" aria-hidden="true" />
                                      <span class="sr-only">Copy {token} token name</span>
                                    </button>
                                    <button
                                      class="icon-circle error-contrast"
                                      data-copy="pairing-token-value"
                                      data-token={token}
                                      type="button"
                                    >
                                      <Palette class="icon" aria-hidden="true" />
                                      <span class="sr-only">Copy {token} color value</span>
                                    </button>
                                    <div class="icon-circle error-contrast">
                                      <Exclamation class="icon" aria-hidden="true" />
                                    </div>
                                  </div>
                                  <p class="pairing-contrast-info"></p>
                                </div>
                              </div>
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
        ))
      }
    </section>

    <section id="full-palette-section" class="page-container">
      <h2>Raw palette</h2>
      <div class="palettes-wrapper">
        {
          THEMES.map(([theme, themeName]) => (
            <div>
              <h3>{themeName}</h3>
              <ul class="base-list" data-theme={theme}>
                {
                  ALL_COLORS.map((colorToken) => (
                    <li>
                      <code>{colorToken}</code>
                      <div class="palette-color-box" style={`background: var(${colorToken})`}></div>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<script>
  import { copyText } from "../../scripts/clipboard";
  import { audit, flatten, ratio, type UIKind } from "../../scripts/contrast";

  listeners();

  /**
   * Sets up event listeners for this page.
   */
  function listeners() {
    const main = document.getElementsByTagName("main")[0];

    main?.addEventListener("click", (e) => {
      const copyBtn = (e.target as HTMLElement)
        .closest<HTMLButtonElement>("[data-copy]");

      if (!copyBtn) return;

      const copyType = copyBtn.dataset.copy ?? "";

      if (copyType === "pairing-surface-token-name") {
        return copySurfaceTokenName(copyBtn);
      }

      if (copyType.match(/^(pairing-surface-token)-(?!.*name)\w+/)) {
        return copySurfaceTokenValue(copyBtn);
      }

      if (copyType === "pairing-token-name") {
        return copyPairingTokenName(copyBtn);
      }

      if (copyType === "pairing-token-value") {
        return copyPairingTokenValue(copyBtn);
      }
    });
  }

  /**
   * Crawls the DOM from the clicked button to its respective
   * theme box and copies the surface token name to the user's
   * clipboard.
   *
   * @param btn Clicked button element. Expected to be on the
   *   theme box header element.
   */
  function copySurfaceTokenName(btn: HTMLElement) {
    const themedBox = btn
      .closest(".color-pairing-box")
      ?.querySelector<HTMLElement>(".pairing-sample");

    const tokenName = themedBox?.dataset.surface;
    if (!tokenName) return;

    copyText(tokenName.trim());
  }

  /**
   * Crawls the DOM from the clicked button to its respective
   * theme box, computes the surface token value into its CSS
   * color, and copies to the user's clipboard.
   *
   * @param btn Clicked button element. Expected to be on the
   *   theme box header element.
   */
  function copySurfaceTokenValue(btn: HTMLElement) {
    const themedBox = btn
      .closest(".color-pairing-box")
      ?.querySelector<HTMLElement>(".pairing-sample");

    const tokenName = themedBox?.dataset.surface;
    if (!themedBox || !tokenName) return;

    const color = getComputedStyle(themedBox).getPropertyValue(tokenName);
    copyText(color.trim());
  }

  /**
   * Crawls the DOM from the clicked button to its respective
   * theme box and copies the pairing token to the user's
   * clipboard.
   *
   * @param btn Clicked button element. Expected to have the
   *   pairing token name in its dataset.
   */
  function copyPairingTokenName(btn: HTMLElement) {
    const tokenName = btn.dataset.token;
    if (!tokenName) return;

    copyText(tokenName.trim());
  }

  /**
   * Crawls the DOM from the clicked button to its respective
   * theme box, computes the pairing token value into its CSS
   * color and, copies the pairing token to the user's
   * clipboard.
   *
   * @param btn Clicked button element. Expected to have the
   *   pairing token name in its dataset and be within its
   *   corresponding theme box.
   */
  function copyPairingTokenValue(btn: HTMLElement) {
    const themedBox = btn
      .closest(".color-pairing-box")
      ?.querySelector<HTMLElement>(".pairing-sample");

    const tokenName = btn.dataset.token;
    if (!themedBox || !tokenName) return;

    const color = getComputedStyle(themedBox).getPropertyValue(tokenName);
    copyText(color.trim());
  }

  // WCAG contrast ratio auditing pipeline
  const samples = document.querySelectorAll<HTMLElement>(".pairing-sample");

  for (const sample of samples) {
    const cell = sample.closest<HTMLElement>(".color-pairing-theme");
    const surfaceToken = sample.dataset.surface;
    if (!cell || !surfaceToken) continue;

    const elementType = sample.dataset.kind as UIKind | undefined;
    if (!elementType) {
      showContrastFailure(sample, "Unresolved");
      continue;
    }

    const cs = getComputedStyle(cell);
    const base = cs.getPropertyValue("--surface-base").trim();
    const surface = cs.getPropertyValue(surfaceToken).trim();
    const text = getComputedStyle(sample).color;

    // composite of the surface over its theme background
    const bg = flatten(base, surface);

    // composite of text over the above
    const fg = flatten(base, surface, text);
    if (!bg || !fg) {
      showContrastFailure(sample, "Unresolved");
      continue;
    };

    const cr = ratio(bg, fg);
    if (audit(cr, elementType)) {
      showContrastInfo(sample, cr);
    }
    else {
      showContrastFailure(sample, cr);
    }
  }

  function showContrastInfo(sample: Element, ct: number) {
    const wrapperEl = sample.querySelector<HTMLElement>(".pairing-sample-details.audit-success");
    const infoEl = sample.querySelector<HTMLElement>(".audit-success > .pairing-contrast-info");
    if (!wrapperEl || !infoEl) return;

    infoEl.innerText = `Ratio: ${ct.toFixed(2)}`;
    wrapperEl.hidden = false;
  }

  function showContrastFailure(sample: Element, ct: number | string) {
    const wrapperEl = sample.querySelector<HTMLElement>(".pairing-sample-details.audit-failure");
    const infoEl = sample.querySelector<HTMLElement>(".audit-failure > .pairing-contrast-info");
    if (!wrapperEl || !infoEl) return;

    typeof ct === "number"
      ? infoEl.innerText = `Ratio: ${ct.toFixed(2)}`
      : infoEl.innerText = ct;

    wrapperEl.hidden = false;
  }
</script>

<style>
  main {
    padding: var(--space-section-2xl) var(--space-section-sm);
  }

  section h2 {
    margin-bottom: var(--space-md);
  }

  p {
    margin: 0;
  }

  button {
    cursor: pointer;
  }

  #color-pairings-section {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-section-sm);
  }

  .palette-surface-title {
    display: flex;
    gap: var(--space-2xs);
    padding: var(--space-xs) 0 var(--space-xs) var(--space-sm);
  }

  .color-pairings-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .color-pairing-box {
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    overflow: clip;
  }

  .color-pairing-box span {
    display: block;
    padding: var(--space-3xs) 0;
    text-align: center;
  }

  .color-pairing-header {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .color-pairing-header-controls {
     position: absolute;
     left: calc(var(--space-xs) + 0.35rem);
     display: flex;
     gap: var(--space-2xs);
  }

  .color-pairing-theme {
    height: 100%;
    padding: var(--space-sm);
    background-color: var(--surface-base);
    border-top: 1px solid var(--text-on-base);
  }

  .pairing-sample {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding:var(--space-2xs) 0;
  }

  .pairing-sample-info {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .pairing-sample-details {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-3xs);
  }

  .pairing-sample-details.audit-failure {
    background-color: #fff;
    color: #000;
    border-radius: var(--radius-lg);
  }

  .pairing-sample-controls {
    display: flex;
    gap: var(--space-2xs);
  }

  .icon-circle {
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-circle);
    height: var(--icon-size-md);
    width: var(--icon-size-md);
  }

  .icon-circle > .icon {
    display: block;
    flex: none;
    height: var(--icon-size-sm);
    width: var(--icon-size-sm);
  }

  .icon-circle.error-contrast {
    background-color: #fff;
    color: #c00;
    border: 1px solid #c00;
  }

  .icon-circle.outer-contrast {
    background-color: var(--surface-base);
    color: var(--text-on-base);
    border: 1px solid var(--text-on-base);
  }

  .icon-circle.theme-contrast {
    background-color: transparent;
    color: inherit;
    border: 1px solid currentColor;
  }

  .pairing-contrast-info {
    font-size: var(--font-size-sm);
  }

  .audit-failure .pairing-contrast-info {
    color: #c00;
  }

  #full-palette-section {
    margin-top: var(--space-section-md);
  }

  #full-palette-section h3 {
    text-align: center;
  }

  #full-palette-section ul {
    margin-top: var(--space-2xs);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm);
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
    background-color: var(--surface-base);
    color: var(--text-on-base);
  }

  #full-palette-section li code {
    font-style: italic;
    font-size: var(--font-size-sm);
  }

  .palettes-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-md);
  }

  .palette-color-box {
    height: var(--space-xl);
    width: 100%;
    border: 1px solid var(--text-on-base);
    border-radius: var(--radius-md);
  }
</style>
