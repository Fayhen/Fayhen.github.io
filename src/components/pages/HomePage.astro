---
import "../../styles/global.css";

import ArrowRight from "../../assets/icons/fas/arrow-right.svg";

import Base from "../../layouts/Base.astro";
import ContactMe from "../ContactMe.astro";
import ExperienceItem from "../ExperienceItem.astro";
import Footer from "../Footer.astro";
import Header from "../Header.astro";
import Presentation from "../Presentation.astro";
import ProfilePic from "../ProfilePic.astro";
import ProjectStrips from "../ProjectStrips.astro";
import StackIcon from "../StackIcon.astro";

import { experience } from "../../data/experience";
import { projects } from "../../data/projects";
import { stacks } from "../../data/stacks";
import { volunteering } from "../../data/experience";

import { getRelativeLocaleUrl } from "astro:i18n";
import { isLocale } from "../../i18n/locales";
import { useTranslation } from "../../i18n";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);

const navItems = [
  { label: t("nav.home"), href: "#" },
  { label: t("nav.skills"), href: "#skills-section" },
  { label: t("nav.projects"), href: "#projects-section" },
  { label: t("nav.contact"), href: "#contact-section" }
];
---

<Base title={t("intro.role")}>
  <Header {navItems} />

  <main id="main-content" tabindex="-1">
    <div id="intro-wrapper">
      <section id="intro-section" class="page-container">
        <ProfilePic />
        <Presentation />
      </section>
    </div>

    <div id="skills-wrapper">
      <section id="skills-section" class="page-container">
        <h2>{t("skills.title")}</h2>

        <div class="major-areas">
          <div class="card major-area-detail">
            <h3>{t("skills.fullstackTitle")}</h3>
            <p>{t("skills.fullstackBody")}</p>
          </div>
          <div class="card major-area-detail">
            <h3>{t("skills.backendTitle")}</h3>
            <p>{t("skills.backendBody")}</p>
          </div>
          <div class="card major-area-detail">
            <h3>{t("skills.frontendTitle")}</h3>
            <p>{t("skills.frontendBody")}</p>
          </div>
        </div>

        <div class="experience-wrapper">
          <div class="experience-column">
            <h3>{t("skills.previousXpTitle")}</h3>
            <ul class="base-list">
              {Object.values(experience).map((item) => <ExperienceItem experience={item} />)}
            </ul>
            <h3>{t("skills.volunteeringTitle")}</h3>
            <ul class="base-list">
              {Object.values(volunteering).map((item) => <ExperienceItem experience={item} />)}
            </ul>
          </div>

          <div class="tools-column">
            <div class="stacks">
              <h3>{t("skills.stacksTitle")}</h3>
              <ul class="base-list stack-list">
                {Object.values(stacks).map((stack) => <StackIcon stack={stack} />)}
              </ul>
            </div>
            <div class="activity hidden" aria-hidden="true">
              {t("skills.activityTitle")}
            </div>
          </div>
        </div>
      </section>
    </div>

    <div id="projects-wrapper">
      <section id="projects-section" class="page-container">
        <h2>{t("projects.title")}</h2>
        <p>{t("projects.description")}</p>
        <ProjectStrips {projects} />
        <a href={getRelativeLocaleUrl(locale, "projects")} class="projects-button">
          {t("projects.seeMore")}
          <ArrowRight class="link-icon" aria-hidden="true" />
        </a>
      </section>
    </div>

    <div id="contact-wrapper">
      <section id="contact-section" class="page-container">
        <ContactMe />
      </section>
    </div>
  </main>

  <Footer />
</Base>

<style>
  #intro-wrapper {
    padding-top: var(--space-section-md);
    background-color: var(--surface-base);
    color: var(--text-on-base);
    border-bottom: var(--border-section);
  }

	#intro-section {
		display: flex;
		align-items: center;
		column-gap: clamp(var(--space-section-sm), 8vw, var(--space-section-lg));
		padding-block: var(--space-section-2xl) var(--space-section-4xl);
	}

  #skills-wrapper {
    --surface-raised: var(--surface-raised-on-subtle);

    background-color: var(--surface-subtle);
    color: var(--text-on-subtle);
    border-bottom: var(--border-section);
  }

  #skills-wrapper h2 {
    margin: var(--space-lg) 0;
  }

  #skills-section {
    display: flex;
    flex-direction: column;
		align-items: center;
		padding-block: var(--space-section-md) var(--space-section-3xl);
  }

  .major-areas {
    display: flex;
    flex-direction: row;
    gap: 0 var(--space-lg);
  }

  /* Breakpoint: --bp-sm */
  @media (width <= 40rem) {
    #intro-section,
    #skills-section {
      flex-direction: column;
      text-align: center;
      padding-block: var(--space-section-md) var(--space-section-xl);
    }

    .major-areas {
      flex-direction: column;
      gap: var(--space-lg) 0;
    }
  }

  .major-area-detail {
    padding: var(--space-md);
    border-radius: var(--radius-lg);
  }

  .major-area-detail h3 {
    text-align: center;
  }

  .experience-wrapper {
    display: flex;
    flex-wrap: nowrap;
    margin-top: var(--space-xl);
    gap: 0 var(--space-lg);
  }

  .experience-column {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .experience-column ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-md) 0;
  }

  .experience-column h3 + ul {
    margin-top: var(--space-md);
  }

  .experience-column ul + h3 {
    margin-top: var(--space-xl);
  }

  .tools-column {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-align: center;
  }

  /* Breakpoint: custom literal */
  @media (width <= 55rem) {
    .experience-wrapper {
      display: flex;
      flex-direction: column-reverse;
    }

    .tools-column {
      margin-top: 0;
    }
  }

  .stacks {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md) 0;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
  }

  .activity {
    height: 100%;
  }

  #projects-wrapper {
    background-color: var(--surface-base);
    color: var(--text-on-base);
  }

  #projects-section {
		display: flex;
    flex-direction: column;
		align-items: center;
		padding-block: var(--space-section-md) var(--space-section-3xl);
  }

  .projects-button {
    display: flex;
    align-self: center;
    align-items: center;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-pill);
    margin-top: var(--space-lg);
    color: var(--text-link);
    text-decoration: underline;
    text-wrap: nowrap;
  }

  .link-icon {
    color: var(--text-link);
    height: var(--icon-size-sm);
    width: var(--icon-size-sm);
    margin: 0 0 -0.1rem 0.1rem;
  }

  .projects-button:hover,
  .projects-button:focus-visible,
  .projects-button:hover .link-icon,
  .projects-button:focus-visible .link-icon {
    color: var(--text-link-hover);
  }

  #contact-wrapper {
    background-color: var(--surface-inverse);
    color: var(--text-on-inverse);
  }

  #contact-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
		padding-block: var(--space-section-lg) var(--space-section-3xl);
    text-align: center;
  }
</style>
