---
import "../../styles/global.css";

import Base from "../../layouts/Base.astro";
import ContactMe from "../ContactMe.astro";
import Footer from "../Footer.astro";
import Header from "../Header.astro";
import ProjectCTAs from "../ProjectCTAs.astro";
import ProjectCategoryTag from "../ProjectCategoryTag.astro";
import StackPill from "../StackPill.astro";

import { projects } from "../../data/projects";

import { getRelativeLocaleUrl } from "astro:i18n";
import { isLocale } from "../../i18n/locales";
import { useTranslation } from "../../i18n";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);

const navItems = [
  { label: t("nav.backHome"), href: getRelativeLocaleUrl(locale, "") },
  { label: t("nav.projects"), href: "#intro-section" },
  { label: t("nav.contact"), href: "#contact-section" }
];
---

<Base title={t("projectsPage.siteTitle")}>
  <Header {navItems} />

  <main id="main-content" tabindex="-1">
    <div id="intro-wrapper">
      <section id="intro-section" class="page-container">
        <h1>{t("projectsPage.title")}</h1>
        <p>{t("projectsPage.intro")}</p>
        <ul class="base-list">
          {projects.map((p) =>
            <li class="card project-list-card" data-category={p.category}>
              <div>
                <div class="category-tag-wrapper">
                  <ProjectCategoryTag category={p.category} />
                </div>
                <h2>{p.title}</h2>
              </div>
              <div class="ctas">
                <ProjectCTAs project={p} />
              </div>
              <p>{p.description[locale]}</p>
              <div class="footer">
                <ul class="base-list stacks-row">
                  {p.stacks.map((stack) => <StackPill stack={stack} badgeClasses="project-stack-badge" />)}
                </ul>
              </div>
            </li>
          )}
        </ul>
      </section>
    </div>

    <div id="contact-wrapper">
      <section id="contact-section" class="page-container">
        <ContactMe />
      </section>
    </div>
  </main>

  <Footer />
</Base>

<style>
  #intro-wrapper {
    padding-top: var(--space-section-md);
    background-color: var(--surface-base);
    color: var(--text-on-base);
    border-bottom: var(--border-section);
  }

  #intro-wrapper section {
		display: flex;
    flex-direction: column;
		align-items: center;
		column-gap: clamp(var(--space-section-sm), 8vw, var(--space-section-lg));
		padding-block: var(--space-section-2xl) var(--space-section-4xl);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-md) 0;
    width: 100%;
    overflow: hidden;
  }

  .project-list-card {
    position: relative;
    padding: var(--space-md);
    border-radius: var(--radius-lg);
  }

  .category-tag-wrapper {
    margin-bottom: var(--space-2xs);
  }

  .ctas {
    margin-inline: auto;
    margin-top: var(--space-xs);
  }

  @media (width >= 900px) {
    .ctas {
      position: absolute;
      top: var(--space-md);
      right: var(--space-md);
      margin-top: 0;
    }
  }

  .stacks-row {
    flex-direction: row;
    gap: 0 var(--space-md);
  }

  #contact-wrapper {
    background-color: var(--surface-inverse);
    color: var(--text-on-inverse);
  }

  #contact-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
		padding-block: var(--space-section-lg) var(--space-section-3xl);
    text-align: center;
  }
</style>