---
import Image from "astro/components/Image.astro";

import type { Stack } from "../data/stacks";

interface Props {
  badgeClasses?: string
  border?: string
  padding?: string
  stack: Stack
}

const { stack } = Astro.props;

const badgeClasses = Astro.props.badgeClasses ?? "";
const border = Astro.props.border ?? "none";
const padding = Astro.props.padding ?? "0.15rem 0.5rem 0.025rem 0.5rem";
---

<li class=`${badgeClasses} pill` style=`--border: ${border}; --padding: ${padding};`>
  <Image src={stack.icon} alt={stack.name} class="icon" />
  <span>{stack.shortName}</span>
</li>

<style>
  .pill {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    align-self: center;
    gap: 0 0.5rem;
    padding: var(--padding);
    border: var(--border);
    border-radius: 1rem;
    font-size: smaller;
    transition: transform ease 100ms;
  }

  .pill:hover {
    transform: translate(0, -1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill,
    .pill:hover {
      transition: none;
      transform: none;
    }
  }

  .pill span {
    margin-bottom: 0.15rem;
  }

  .icon {
    height: 1rem;
    width: 1rem;
    object-fit: contain;
  }
</style>

