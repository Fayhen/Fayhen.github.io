---
import type { Stack } from "../data/stacks";

interface Props {
  badgeClasses?: string
  border?: string
  padding?: string
  stack: Stack
}

const { stack } = Astro.props;

const badgeClasses = Astro.props.badgeClasses ?? "";
const border = Astro.props.border ?? "none";
const padding = Astro.props.padding ?? "0.15rem 0.5rem";

const Original = stack.icon;
const Themeable = stack.iconThemeable;
---

<li class=`${badgeClasses} pill` style=`--border: ${border}; --padding: ${padding};`>
  <Original class="stack-icon-svg-original" aria-hidden="true" />
  <Themeable class="stack-icon-svg-themeable" aria-hidden="true" />
  <span>{stack.shortName}</span>
</li>

<style>
  .pill {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    align-self: center;
    gap: 0 var(--space-2xs);
    padding: var(--padding);
    border: var(--border);
    border-radius: var(--radius-pill);
    font-size: smaller;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .pill:hover {
    transform: translate(0, -1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill,
    .pill:hover {
      transform: none;
    }
  }

  .pill svg {
    height: var(--icon-size-sm);
    width: var(--icon-size-sm);
  }

  .stack-icon-svg-original {
    display: var(--icon-original-display, revert);
  }

  .stack-icon-svg-themeable {
    display: var(--icon-themeable-display, none);
    color: var(--icon-brand);
  }
</style>

