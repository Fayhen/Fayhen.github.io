---
import EmailIcon from "../assets/icons/fas/envelope-solid-full.svg";
import GitHubIcon from "../assets/icons/fab/github-brands-solid-full.svg";
import LinkedInIcon from "../assets/icons/fab/square-linkedin-brands-solid-full.svg";

import { email, github, linkedIn } from "../data/contacts";
import { isLocale } from "../i18n/locales";
import { useTranslation } from "../i18n";

interface Props {
  titleLevel?: 2 | 3
}

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);

const { titleLevel = 2 } = Astro.props;
const Heading = `h${titleLevel}` as const;
---

<div>
  <Heading class="text-section-title">{t("contact.title")}</Heading>
  <p>{t("contact.subtitle")}</p>
  <ul class="base-list">
    <li>
      <a href={`mailto:${email}`} aria-label={t("contact.emailAriaLabel")}>
        <EmailIcon class="contact-icon" aria-hidden="true" />
      </a>
    </li>
    <li>
      <a
        href={linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t("contact.linkedInAriaLabel")}
      >
        <LinkedInIcon class="contact-icon" aria-hidden="true" />
      </a>
    </li>
    <li>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t("contact.githubAriaLabel")}
      >
        <GitHubIcon class="contact-icon" aria-hidden="true" />
      </a>
    </li>
  </ul>
</div>

<style>
  p {
    font-size: var(--text-body-lead);
  }

  ul {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 0 var(--space-md);
  }

  .contact-icon {
    height: 3.15rem;
    width: 3.15rem;
    color: var(--text-on-inverse);
  }

  .contact-icon:hover,
  a:focus-visible .contact-icon {
    color: var(--text-on-inverse-hover);
  }
</style>
