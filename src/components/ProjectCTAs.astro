---
import GitHub from "../assets/icons/fab/github-brands-solid-full.svg";
import Globe from "../assets/icons/fas/globe-solid-full.svg";

import { isLocale } from "../i18n/locales";
import { useTranslation } from "../i18n";

import type { Project } from "../data/projects";

interface Props {
  project: Project
}

const { project } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);
---

<div class="ctas">
  {
    project.repositoryLink &&
      <a href={project.repositoryLink}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-button-secondary cta-link"
      >
        <GitHub
          height="var(--icon-size-md)"
          width="var(--icon-size-md)"
          class="cta-button-secondary-icon"
          aria-label={t("projects.sourceAriaLabel")}
        />
        {t("projects.seeCode")}
      </a>
  }
  {
    project.productionLink &&
      <a href={project.productionLink}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-button-primary cta-link"
      >
        <Globe
          height="var(--icon-size-md)"
          width="var(--icon-size-md)"
          class="cta-button-primary-icon"
          aria-label={t("projects.websiteAriaLabel")}
        />
        {t("projects.seeLive")}
      </a>
  }
</div>

<style>
  .ctas {
    display: flex;
    gap: var(--space-xs);
  }

  .cta-button-primary {
    background-color: var(--surface-action-primary);
    color: var(--text-on-action-primary);
  }

  .cta-button-secondary {
    background-color: var(--surface-action-secondary);
    color: var(--text-on-action-secondary);
  }

  .cta-link {
    display: flex;
    align-self: center;
    align-items: center;
    gap: 0 var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-pill);
    text-decoration: none;
    text-wrap: nowrap;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .cta-link:hover {
    transform: translate(0, -1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-link,
    .cta-link:hover {
      transition: none;
      transform: none;
    }
  }
</style>