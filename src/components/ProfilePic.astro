---
import { Image } from "astro:assets";
import picture from "../assets/images/profile-pic.jpg";
---

<Image
  src={picture}
  alt="Diego Garcia"
  class="pic"
  height={640}
  width={640}
  loading="eager"
  fetchpriority="high"
/>

<style>
  .pic {
    height: 21.5rem;
    width: auto;
    border-radius: var(--radius-circle);
  }
</style>
