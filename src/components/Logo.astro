---
import LogoDark from "../assets/images/logo-dark.svg";
import LogoLight from "../assets/images/logo-light.svg";
---
<a href="/">
  <LogoLight class="logo logo-light" />
  <LogoDark class="logo logo-dark" />
</a>

<style>
  .logo {
    height: 3rem;
    width: auto;
  }

  .logo-dark {
    display: none;
  }

:global([data-theme="dark"]) .logo-light,
:global([data-theme="retro-dark"]) .logo-light {
  display: none;
}

:global([data-theme="dark"]) .logo-dark,
:global([data-theme="retro-dark"]) .logo-dark {
  display: block;
}

</style>
