---
import Image from "astro/components/Image.astro";

interface Props {
  icon: ImageMetadata
  alt?: string
  height?: string
  width?: string
}

const { icon } = Astro.props;
const alt = Astro.props.alt ?? "Icon";
const height = Astro.props.height ?? "3rem";
const width = Astro.props.width ?? "3rem";
---

<div style=`--icon-height: ${height}; --icon-width: ${width};`>
  <Image src={icon} alt={alt} />
</div>

<style>
  img {
    height: var(--icon-height);
    width: var(--icon-width);
    object-fit: contain;
  }
</style>