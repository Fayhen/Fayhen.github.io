---
interface Props {
  category: string
}

const { category } = Astro.props;
---

<span class="category-tag" data-category={category}>
  {category}
</span>

<style>
  .category-tag {
    place-self: start start;
    display: inline-block;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-pill);
    background: var(--accent-bg);
    color: var(--accent);
    font-size: var(--font-size-sm);
    letter-spacing: 0.05em;
    line-height: var(--line-height-ui);
    text-transform: uppercase;
  }

  .category-tag[data-category="backend"] {
    --accent: var(--text-on-accent-backend);
    --accent-bg: var(--surface-accent-backend);
  }

  .category-tag[data-category="frontend"] {
    --accent: var(--text-on-accent-frontend);
    --accent-bg: var(--surface-accent-frontend);
  }

  .category-tag[data-category="fullstack"] {
    --accent: var(--text-on-accent-fullstack);
    --accent-bg: var(--surface-accent-fullstack);
  }
</style>