---
import { Image } from "astro:assets";

import ProjectCTAs from "./ProjectCTAs.astro";
import StackPill from "./StackPill.astro";

import type { Project } from "../data/projects";

interface Props {
  projects: Project[]
}

const { projects } = Astro.props;
---

<ul class="base-list featured-grid">
  {projects.filter((p) => p.featured).map((p) =>
    <li class="secondary-card animated featured-card" data-category={p.category}>
      <div class="hero">
        {p.picture && <Image src={p.picture} alt={p.title} />}
      </div>
      <span class="category-tag">{p.category}</span>
      <h3>{p.title}</h3>
      <p>{p.description}</p>
      <div class="footer">
        <ul class="base-list stacks-row">
          {p.stacks.map((stack) => <StackPill stack={stack} badgeClasses="project-stack-badge" />)}
        </ul>
        <ProjectCTAs project={p} />
      </div>
    </li>
  )}
</ul>

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 1.5rem;
    width: 100%;
  }

  @media (width <= 60rem) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  .featured-card[data-category="backend"] {
    --accent: var(--badge-backend-fg);
    --accent-bg: var(--badge-backend-bg);
  }

  .featured-card[data-category="frontend"] {
    --accent: var(--badge-frontend-fg);
    --accent-bg: var(--badge-frontend-bg);
  }

  .featured-card[data-category="fullstack"] {
    --accent: var(--badge-fullstack-fg);
    --accent-bg: var(--badge-fullstack-bg);
  }

  .featured-card {
    display: grid;
    grid-row: span 5;
    grid-template-columns: 1fr;
    grid-template-rows: subgrid;
    align-items: start;
    padding: 1rem;
    row-gap: 0.5rem;
    border-radius: 15px;
    overflow: hidden;
    position: relative;
    container-type: inline-size;
  }

  @container (min-width: 28rem) {
    .featured-card .hero {
      grid-column: 1;
      grid-row: 1 / -1;
      aspect-ratio: auto;
      align-self: stretch;
      height: auto;
    }

    .featured-card .category-tag,
    .featured-card h3,
    .featured-card p,
    .featured-card .footer {
      grid-column: 2;
    }
  }

  @media (32rem <= width <= 60rem) {
    .featured-card {
      grid-template-columns: 1fr 1.4fr;
      grid-template-rows: auto auto 1fr auto;
      column-gap: 1rem;
    }
  }

  .hero {
    background: var(--bg-placeholder);
    aspect-ratio: 16 / 9;
    height: 56.25cqi;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .hero img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .category-tag {
    justify-self: start;
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  .footer {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 0 0.5rem;
    margin-top: auto;
  }

  .stacks-row {
    display: flex;
    flex-flow: row wrap;
    gap: 0.5rem;
  }
</style>