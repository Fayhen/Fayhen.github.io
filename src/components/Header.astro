---
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

import Bars from "../assets/icons/fas/bars-solid-full.svg";
import Xmark from "../assets/icons/fas/xmark-solid-full.svg";

import { getRelativeLocaleUrl } from "astro:i18n";
import { isLocale } from "../i18n/locales";
import { useTranslation } from "../i18n";


interface Props {
  navItems: Array<{
    label: string;
    href: string;
  }>
}

const { navItems } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "en";
const t = useTranslation(locale);
---

<header>
  <div class="page-container header-container">
    <a href={getRelativeLocaleUrl(locale, "")} aria-label={t("header.backToTop")} class="logo-wrapper">
      <Logo />
      <span>Fayhen</span>
    </a>
    <div class="actions">
      <nav id="primary-nav">
        <ul>
          {navItems.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <div class="lang-switch-wrapper">
        <LangSwitch />
      </div>
      <ThemeToggle />
      <button
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label={t("header.openMenu")}
        data-label-open={t("header.openMenu")}
        data-label-close={t("header.closeMenu")}
      >
        <Bars class="menu-icon menu-icon-open" aria-hidden="true" />
        <Xmark class="menu-icon menu-icon-close" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    height: var(--header-height);
    width: 100%;
    padding: var(--space-xs) 0;
    z-index: 100;
    backdrop-filter: var(--nav-filter);
    color: var(--text-on-overlay);
    background-color: var(--surface-overlay);
    box-shadow: var(--nav-shadow)
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    gap: 0 var(--space-xs);
    height: calc(var(--header-height) - (2 * var(--space-xs)));
    color: inherit;
    font-size: var(--text-brand);
    text-decoration: none;
  }

  .actions {
    display: flex;
    align-items: center;
  }

  nav {
    display: none;
    position: absolute;
    top: var(--header-height);
    right: 0;
    background: var(--surface-overlay-panel);
    box-shadow: var(--nav-shadow-mobile);
    padding: var(--space-md);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--motion-base) var(--motion-ease),
      transform var(--motion-base) var(--motion-ease),
      display var(--motion-base) allow-discrete;
  }

  nav[data-open] {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    nav[data-open] {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-md) 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--text-link);
    text-decoration: var(--link-decoration);
  }

  nav a:hover {
    color: var(--text-link-hover);
  }

  .lang-switch-wrapper {
    margin: 0 var(--space-md);
  }

  .menu-button {
    display: grid;
    padding: var(--space-2xs);
    border: none;
    cursor: pointer;
    background-color: inherit;
    color: var(--text-on-overlay);
  }

  .menu-icon {
    grid-area: 1 / 1;
    height: var(--icon-size-md);
    width: var(--icon-size-md);
    transition:
      opacity var(--motion-base) var(--motion-ease),
      transform var(--motion-base) var(--motion-ease);
  }

  .menu-icon-open {
    opacity: 1;
    transform: rotate(0);
  }

  .menu-button[aria-expanded="true"] .menu-icon-open {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .menu-icon-close {
    opacity: 0;
    transform: rotate(90deg);
  }

  .menu-button[aria-expanded="true"] .menu-icon-close {
    opacity: 1;
    transform: rotate(0);
  }

  /* Breakpoint: --bp-md */
  @media (width >= 48rem) {
    nav {
      display: block;
      position: static;
      background: none;
      box-shadow: none;
      padding: 0;
      opacity: 1;
      transform: none;
      transition: none;
    }

    nav ul {
      flex-direction: row;
      gap: 0 var(--space-lg);
    }

    .menu-button {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("header");
  const menuBtn = document.querySelector<HTMLButtonElement>(".menu-button");
  const nav = document.querySelector<HTMLElement>("#primary-nav");

  const labelOpen = menuBtn?.dataset.labelOpen ?? "";
  const labelClose = menuBtn?.dataset.labelClose ?? "";

  const containsFocus = (el: Element | null) => {
    return !!el?.contains(document.activeElement);
  }

  const isFocusInMenu = () => {
    return containsFocus(nav) || containsFocus(menuBtn);
  }

  const isMenuOpen = () => nav?.hasAttribute("data-open") ?? false;

  function openMenu() {
    if (!nav || !menuBtn) return;

    nav.setAttribute("data-open", "");
    menuBtn.setAttribute("aria-expanded", "true");
    menuBtn.setAttribute("aria-label", labelClose);
    nav.querySelector("a")?.focus();
  }

  function closeMenu({ restoreFocus = true} = {}) {
    if (!nav || !menuBtn) return;

    nav.removeAttribute("data-open");
    menuBtn.setAttribute("aria-expanded", "false");
    menuBtn.setAttribute("aria-label", labelOpen);

    if (restoreFocus) menuBtn.focus();
  }

  function toggleMenu() {
    if (isMenuOpen()) closeMenu();
    else openMenu();
  }

  new ResizeObserver(() => {
    if (!nav || !menuBtn) return;
    const isDesktopNav = !menuBtn.checkVisibility();

    if (isDesktopNav && isMenuOpen()) {
      closeMenu({ restoreFocus: false });
      return;
    }

    if (!isDesktopNav && !isMenuOpen() && containsFocus(nav)) {
      menuBtn.focus();
    }
  }).observe(document.documentElement);

  menuBtn?.addEventListener("click", toggleMenu);

  nav?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) {
      closeMenu({ restoreFocus: false });
    }
  });

  header?.addEventListener("focusout", (e) => {
    if (!isMenuOpen()) return;

    const nextEl = e.relatedTarget as Node | null;
    if (nextEl && header.contains(nextEl)) return;

    // close menu if user tabs outside the header
    closeMenu({ restoreFocus: false });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !isMenuOpen()) return;
    closeMenu({ restoreFocus: isFocusInMenu() });
  });

  document.addEventListener("pointerdown", (e) => {
    if (!isMenuOpen() || !nav || !menuBtn) return;
    if (nav.contains(e.target as Node)) return;
    if (menuBtn.contains(e.target as Node)) return;
    closeMenu({ restoreFocus: isFocusInMenu() });
  });
</script>
