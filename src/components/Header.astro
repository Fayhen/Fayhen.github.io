---
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";

interface Props {
  navItems: Array<{
    label: string;
    href: string;
  }>
}

const { navItems } = Astro.props;
---

<header>
  <div class="page-container header-container">
    <div class="logo-wrapper">
      <Logo />
      <p>Fayhen</p>
    </div>
    <div class="actions">
      <nav>
          <ul>
            {navItems.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
          </ul>                                                                                                                                                                                                                           
        </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;

    width: 100%;
    padding: 0.5rem 0;

    backdrop-filter: var(--navbar-filter);

    color: var(--navbar-fg);                                                                                                                                                                                                          
    background-color: var(--navbar-bg);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-wrapper {
    display: flex;
    gap: 0 1.5rem;
  }

  nav {
    margin: 0 1.5rem;
  }

  nav ul {
    display: flex;
    flex-direction: row;
    gap: 0 1.5rem;

    margin: 0;
    padding: 0;
    list-style-type: none;

    text-wrap: nowrap;
  }

  nav a {
    color: var(--link);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--link-hover);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0 1.5rem;
  }
</style>
