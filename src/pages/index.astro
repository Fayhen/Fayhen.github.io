---
import "../styles/global.css";

import Base from "../layouts/Base.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import Header from "../components/Header.astro";
import Presentation from "../components/Presentation.astro";
import ProfilePic from "../components/ProfilePic.astro";
import Project from "../components/Project.astro";
import ProjectSpotlight from "../components/ProjectSpotlight.astro";
import StackIcon from "../components/StackIcon.astro";

import EmailIcon from "../assets/icons/fas/envelope-solid-full.svg";
import GitHubIcon from "../assets/icons/fab/github-brands-solid-full.svg";
import LinkedInIcon from "../assets/icons/fab/square-linkedin-brands-solid-full.svg";

import { experience } from "../data/experience";
import { projects } from "../data/projects";
import { stacks } from "../data/stacks";
import { volunteering } from "../data/experience";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Skills", href: "/#" },
  { label: "Education", href: "/#" },
  { label: "Experience", href: "/#" },
  { label: "Projects", href: "/#" },
  { label: "Contact me", href: "/#" }
];
---

<Base>
  <Header {navItems} />

  <div id="intro-wrapper">
    <section id="intro-section" class="page-container">
      <ProfilePic />
      <Presentation />
    </section>
  </div>

  <div id="skills-wrapper">
    <section id="skills-section" class="page-container">
      <h1>Skills & Experience</h1>

      <div class="major-areas">
        <div class="major-area-detail">
          <h2>Fullstack</h2>
          <p>Building real-time web applications with Elixir and Phoenix, including CMS and B2B platforms, integrated with distributed backend services.</p>
        </div>
        <div class="major-area-detail">
          <h2>Backend</h2>
          <p>Designing purpose-built APIs and cloud functions, and modernizing legacy systems into scalable, maintainable architectures.</p>
        </div>
        <div class="major-area-detail">
          <h2>Frontend</h2>
          <p>Developing web applications with modern frameworks and Firebase, delivering production-ready solutions across multiple client projects.</p>
        </div>
      </div>

      <div class="experience-wrapper">
        <div class="experience-column">
          <h2>Where I've been:</h2>
          <ul class="base-list">
            {Object.values(experience).map((item) => <ExperienceItem experience={item} />)}
          </ul>
          <h2>I also volunteer:</h2>
          <ul class="base-list">
            {Object.values(volunteering).map((item) => <ExperienceItem experience={item} />)}
          </ul>
        </div>

        <div class="tools-column">
          <div class="stacks">
            <h2>I am building with:</h2>
            <ul class="base-list stack-list">
              {Object.values(stacks).map((stack) => <StackIcon stack={stack} />)}
            </ul>
          </div>
          <div class="activity">
            Activity Placeholder
          </div>
        </div>
      </div>
    </section>
  </div>

  <div id="projects-wrapper">
    <section id="projects-section" class="page-container">
      <h1>Projects</h1>
      <p>Most of my projects are closed-source. Here's a few I can share freely.</p>
      <ul class="base-list featured-strip">
        {projects.filter((p) => p.featured).map((p) => <ProjectSpotlight project={p}/>)}
      </ul>
      <ul class="base-list projects-grid">
        {projects.filter((p) => !p.featured).map((p) => <Project project={p} />)}
      </ul>
    </section>
  </div>

  <div id="contact-wrapper">
    <section id="contact-section" class="page-container">
      <h1>Contact me</h1>
      <p>Have a project in mind? Let's chat.</p>
      <ul class="base-list">
        <li>
          <a href="mailto:diego00alfa@gmail.com" aria-label="Send me an email">
            <EmailIcon class="contact-icon" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/diegogcsouza/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Check my LinkedIn profile. Opens in a new tab."
          >
            <LinkedInIcon class="contact-icon" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            href="https://github.com/Fayhen"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Check my work at GitHub. Open in a new tab."
          >
            <GitHubIcon class="contact-icon" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
	#intro-section {
		display: flex;
		align-items: center;
		column-gap: clamp(2rem, 8vw, 5rem);

		padding-block: 7rem 14rem;
	}

  #skills-wrapper {
    background-color: oklch(95.514% 0.00011 271.152);
  }

  #skills-wrapper h1 {
    margin: 1.5rem 0;
  }

  #skills-section {
    display: flex;
    flex-direction: column;
		align-items: center;

		padding-block: 4rem 8rem;
  }

  .major-areas {
    display: flex;
    flex-direction: row;
    gap: 0 1.5rem;
  }

  @media (max-width: 40rem) {
    #intro-section
    #skills-section {
      flex-direction: column;
      text-align: center;
      padding-block: 4rem 6rem;
    }

    .major-areas {
      flex-direction: column;
      gap: 1.5rem 0;
    }
  }

  .major-area-detail {
    padding: 1rem;
    border-radius: 1rem;

    background-color: oklch(100% 0.00011 271.152);
  }

  .major-area-detail h2 {
    text-align: center;
  }

  .experience-wrapper {
    display: flex;
    flex-wrap: nowrap;
    margin-top: 2rem;
    gap: 0 1.5rem;
  }

  .experience-column {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .experience-column h2 + ul {
    margin-top: 1rem;
  }

  .experience-column ul + h2 {
    margin-top: 2rem;
  }

  .experience-column ul {
    display: flex;
    flex-direction: column;
    gap: 1rem 0;
  }

  .tools-column {
    display: flex;
    flex-direction: column;
    gap: 1rem 0;
    width: 100%;

    text-align: center;
  }

  @media (max-width: 55rem) {
    .experience-wrapper {
      display: flex;
      flex-direction: column-reverse;
    }

    .tools-column {
      margin-top: 0;
    }
  }

  .stacks {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem 0;

    margin-top: 2rem;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .activity {
    height: 100%;
  }

  #projects-section {
		display: flex;
    flex-direction: column;
		align-items: center;
		padding-block: 4rem 8rem;
  }

  .featured-strip {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    width: 100%;
  }

  @media (max-width: 60rem) {
    .featured-strip {
      grid-template-columns: 1fr;
    }
  }

  .projects-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  #contact-wrapper {
    background-color: oklch(27.274% 0.00003 271.152);
    color: oklch(95.514% 0.00011 271.152);
  }

  #contact-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
		padding-block: 4rem 8rem;

    color: var(--navbar-bg);
    text-align: center;
  }

  #contact-section ul {
    display: flex;
    align-self: center;
    gap: 0 1rem;
  }

  #contact-section a {
    padding: 0.1rem;
  }

  .contact-icon {
    height: 3rem;
    width: 3rem;
    color: var(--navbar-bg);
  }

  #contact-section a:focus-visible .contact-icon,
  .contact-icon:hover {
    color: oklch(100% 0.00011 271.152);
  }
</style>
